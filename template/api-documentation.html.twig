{% extends "mise-en-page-minimale.html.twig" %}

{% block head %}
    <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5.29.5/swagger-ui.css"/>
    <style>
        .wrapper {
            width: min(1200px, calc(100% - 3rem));
        }

        #swagger-ui {
            margin: 2rem 0;
        }

        #swagger-ui .topbar {
            display: none;
        }
    </style>
{% endblock %}

{% block breadcrumb %}
    {% include "fil-d-ariane.html.twig" %}
{% endblock %}

{% block content %}
    <h1>Documentation API</h1>
    <p>
        La spécification OpenAPI est disponible au format JSON :
        <a href="{{ open_api_url }}" target="_blank">{{ open_api_url }}</a>
    </p>
    <div id="swagger-ui"></div>
{% endblock %}

{% block scripts %}
    <script src="https://unpkg.com/swagger-ui-dist@5.29.5/swagger-ui-bundle.js" crossorigin="anonymous"></script>
    <script>
        window.onload = function () {
            SwaggerUIBundle({
                dom_id: '#swagger-ui',
                url: {{ swagger_source_url|json_encode|raw }},
                deepLinking: true,
                displayRequestDuration: true,
                defaultModelsExpandDepth: 1,
                docExpansion: 'list'
            });
        };
    </script>
{% endblock %}
