{
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4",
        "twig/twig": "3.*",
        "illuminate/database": "11.*",
        "ext-mysqli": "*",
        "ext-pdo": "*",
        "slim/psr7": "^1.8"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-0": {
            "controller": "",
            "model": "",
            "service": "",
            "db": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs:check": "php-cs-fixer check --diff --verbose",
        "cs:fix": "php-cs-fixer fix --verbose",
        "test": "phpunit --testdox"
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    }
}
